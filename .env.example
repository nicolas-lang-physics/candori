# Server-side only (Vercel env vars / .env for `vercel dev`) — never exposed to the client
ANTHROPIC_API_KEY=
# Model per exercise; defaults to claude-opus-4-8 when unset
CANDORI_MODEL_STORY=claude-opus-4-8
CANDORI_MODEL_ASSOC=claude-opus-4-8
# Extra origins allowed to call /api besides the app's own (comma-separated)
# CANDORI_ALLOWED_ORIGINS=https://preview.example.com

# Client-side (safe to expose; anon key is RLS-protected)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dev only: use canned word pools instead of /api (set by `npm run dev:offline`)
# VITE_CANNED_AI=true
