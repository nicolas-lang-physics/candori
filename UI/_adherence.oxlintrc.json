{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "ui_kits/app-v1/**",
              "ui_kits/app-v2/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|quiet|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'quiet' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlowSurface'] > JSXAttribute > JSXIdentifier[name!=/^(?:heat|radius|children|style|key|ref|className|style|children)$/]",
        "message": "<GlowSurface> doesn't accept that prop. Declared props: heat, radius, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LessonCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|text|children|style|key|ref|className|style|children)$/]",
        "message": "<LessonCard> doesn't accept that prop. Declared props: kicker, text, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReflectionBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:prompt|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<ReflectionBox> doesn't accept that prop. Declared props: prompt, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SoftTimer'] > JSXAttribute > JSXIdentifier[name!=/^(?:progress|label|style|key|ref|className|style|children)$/]",
        "message": "<SoftTimer> doesn't accept that prop. Declared props: progress, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoryWord'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|by|pending|key|ref|className|style|children)$/]",
        "message": "<StoryWord> doesn't accept that prop. Declared props: text, by, pending."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoryWord'] > JSXAttribute[name.name='by'] > Literal[value!=/^(?:user|ai)$/]",
        "message": "<StoryWord> by must be one of 'user' | 'ai'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StreakDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:day|week|style|key|ref|className|style|children)$/]",
        "message": "<StreakDots> doesn't accept that prop. Declared props: day, week, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onSubmit|placeholder|autoFocus|style|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: value, onChange, onSubmit, placeholder, autoFocus, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WordChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:word|by|pending|style|key|ref|className|style|children)$/]",
        "message": "<WordChip> doesn't accept that prop. Declared props: word, by, pending, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WordChip'] > JSXAttribute[name.name='by'] > Literal[value!=/^(?:user|ai)$/]",
        "message": "<WordChip> by must be one of 'user' | 'ai'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
